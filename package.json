{
  "name": "twnty",
  "private": true,
  "version": "0.1.0",
  "description": "A tiny, open-source desktop companion for the 20-20-20 rule",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:exe": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml --features tauri/custom-protocol",
    "start": "src-tauri\\target\\release\\twnty.exe",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "tsc -p tsconfig.web.json && vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.0"
  }
}
